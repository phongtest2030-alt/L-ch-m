<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center">

    <!-- Thứ / Ngày trong tuần -->
    <TextView
        android:id="@+id/widget_day_of_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thứ Tư"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Ngày Dương lịch To -->
    <TextView
        android:id="@+id/widget_solar_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="23"
        android:textColor="@color/widget_primary"
        android:textSize="38sp"
        android:textStyle="bold" />

    <!-- Tháng Năm Dương Lịch -->
    <TextView
        android:id="@+id/widget_solar_month_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tháng 9, 2026"
        android:textColor="@color/widget_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <View
        android:layout_width="40dp"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="@color/widget_divider" />

    <!-- Ngày Âm lịch -->
    <TextView
        android:id="@+id/widget_lunar_day_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Âm: 13/08"
        android:textColor="@color/widget_gold"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Can Chi ngày -->
    <TextView
        android:id="@+id/widget_can_chi_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Giáp Thìn"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

</LinearLayout>
