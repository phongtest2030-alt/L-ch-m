<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Bên trái: Dương lịch to -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_med_day_of_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ Tư"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_med_solar_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23"
            android:textColor="@color/widget_primary"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_med_solar_month_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tháng 09, 2026"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Đường kẻ ngăn cách -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:background="@color/widget_divider" />

    <!-- Bên phải: Âm lịch & Sự kiện sắp tới -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_med_lunar_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Âm lịch: Ngày 13 tháng 8"
            android:textColor="@color/widget_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_med_can_chi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ngày Giáp Thìn - Bính Thân"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_med_hoang_dao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="★ Ngày Hoàng Đạo"
            android:textColor="@color/widget_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Sự kiện / Ngày lễ sắp tới -->
        <LinearLayout
            android:id="@+id/widget_med_event_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_badge_red"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_med_event_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sự kiện: Rằm Trung Thu (15/08 ÂL)"
                android:textColor="@color/widget_holiday"
                android:textSize="11sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
